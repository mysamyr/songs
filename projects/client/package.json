{
  "name": "songpb-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "concurrently -k -n build,server -c yellow,blue \"npm run build:dev\" \"npm run server\"",
    "server": "vite serve --config vite.server.config.js",
    "build": "vite build --config vite.prod.config.js",
    "build:dev": "vite build --config vite.dev.config.js"
  },
  "dependencies": {
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
