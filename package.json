{
  "name": "songpb",
  "version": "1.0.0",
  "description": "Song Pocket Book App",
  "scripts": {
    "start:dev": "concurrently -k -n api,client -c cyan,magenta \"cd projects/api && npm run start:dev\" \"cd projects/client && npm run start:dev\"",
    "secrets:fetch": "node scripts/fetch.js",
    "secrets:upload": "node scripts/upload.js",
    "setup": "node scripts/copy.js",
    "check-formatting": "prettier -l projects scripts",
    "format": "prettier --write projects scripts",
    "lint": "eslint projects scripts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{json,css,md}": ["npm run format", "npm run lint"]
  },
  "keywords": [],
  "author": "Mysamyr",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google-cloud/storage": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": ">=22"
  }
}
