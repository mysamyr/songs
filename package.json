{
  "name": "songpb",
  "version": "1.0.0",
  "description": "Song Pocket Book App",
  "scripts": {
    "secrets:fetch": "node scripts/fetch.js",
    "secrets:upload": "node scripts/upload.js",
    "setup": "node scripts/copy.js",
    "check-formatting": "prettier -l \"projects/**/*.js\" \"scripts/*.js\"",
    "format": "prettier --write \"projects/**/*.js\" \"scripts/*.js\"",
    "check-quality": "eslint \"projects/**/*.js\" \"scripts/*.js\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "npm run format",
      "npm run check-quality"
    ]
  },
  "keywords": [],
  "author": "Mysamyr",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google-cloud/storage": "^7.16.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
